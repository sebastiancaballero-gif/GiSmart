# Copia este archivo a .env.local y ajusta los valores.
# Ver app/api/auth/login/route.ts para el detalle del mock de autenticación.

# Formato: usuario:password:rol:Nombre visible — separados por coma entre usuarios.
AUTH_DEMO_USERS=usuario:contrasena:rol:Nombre Visible

# Secreto para firmar el JWT de demostración (genera uno propio, no reutilices este).
AUTH_JWT_SECRET=cambia-este-valor-por-un-secreto-aleatorio

# API de pg_featureserv con los cables de fibra reales.
FIBER_API_URL=http://testlab.g-gis.com:9000/collections/geo_fiber.fiber_cables/items.json
