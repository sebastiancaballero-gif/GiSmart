# Copia este archivo a .env.local y ajusta los valores.
# Ver app/api/auth/login/route.ts para el detalle del login.

# Secreto para firmar el JWT de sesión (genera uno propio, no reutilices este).
AUTH_JWT_SECRET=cambia-este-valor-por-un-secreto-aleatorio

# Supabase (Project Settings → API Keys). SUPABASE_SECRET_KEY nunca debe llevar
# el prefijo NEXT_PUBLIC_: solo se usa del lado del servidor.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Mapa de fondo (opcional). Sin estas variables se usa OpenStreetMap, cuya
# política no permite uso comercial intensivo. Para producción, un servidor de
# teselas propio o un proveedor con contrato. Ver lib/map/mapa-base.ts.
# NEXT_PUBLIC_TESELAS_URL=https://proveedor/{z}/{x}/{y}.png?key=...
# NEXT_PUBLIC_TESELAS_ATRIBUCION=© Proveedor, © OpenStreetMap
# NEXT_PUBLIC_TESELAS_ZOOM_MAXIMO=20

# Asistente de IA (Avanzado › Asistente IA), opcional. Una clave de Google AI
# Studio; solo se usa en el servidor, nunca con el prefijo NEXT_PUBLIC_. Sin ella
# el asistente dice que falta configurarlo. Ver app/api/asistente/route.ts.
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.5-flash-lite
# Modelos que se prueban si el principal está saturado o sin cuota (vacío: ninguno):
# GEMINI_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3.8-flash
